# Docker Compose 开发环境模板。
# 复制为 .env 后填写真实凭据；模板中的占位值不应直接用于生产。
# 每个配置项上方均保留用途、范围或调参建议。

# --- 应用 -----------------------------------------------------------

# 供 Docker Compose 的 infra/*.yml 读取的环境文件路径；相对 infra 目录解析。
APP_ENV_FILE=../.env
# 运行环境标识；production/prod 会启用更严格的启动安全校验。
APP_ENV=development
# 服务名称；用于 FastAPI 元数据、健康检查和日志识别。
APP_NAME=knowledge-work-assistant
# 后端 API 路由前缀；修改时需同步前端地址和 Nginx 代理规则。
API_PREFIX=/api
# 允许访问后端的浏览器 Origin，多个值用逗号分隔；生产环境应只填写明确的 HTTPS 域名。
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000
# 前端构建时固化的 API 基础路径；修改后需要重新构建前端镜像。
VITE_API_BASE_URL=http://localhost:8000/api
# Nginx 请求体上限（MiB）；需大于 MAX_UPLOAD_SIZE_MB 以覆盖 multipart 开销。
NGINX_MAX_BODY_SIZE_MB=52
# Nginx 上游读写超时；需覆盖最长 Agent 流式运行截止时间。
NGINX_PROXY_TIMEOUT_SECONDS=300
# Hugging Face Transformers 依赖的日志级别；生产通常保持 error 以降低噪声。
TRANSFORMERS_VERBOSITY=error

# --- PostgreSQL 和 SQLAlchemy --------------------------------------

# PostgreSQL 初始化空数据卷时创建的业务数据库名。
POSTGRES_DB=rag_app
# PostgreSQL 初始化空数据卷时创建的业务数据库用户。
POSTGRES_USER=rag_user
# PostgreSQL 初始化空数据卷时使用的数据库密码；修改后不会自动更新既有数据卷。
POSTGRES_PASSWORD=rag_password
# 后端、Worker 和迁移脚本使用的 SQLAlchemy 连接 URL；密码中的保留字符需 URL 编码。
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@postgres:5432/rag_app
# 是否在启动时自动建表；仅适合本地开发，生产应关闭并使用 Alembic 迁移。
AUTO_CREATE_TABLES=true
# 每个 SQLAlchemy 进程保留的常驻数据库连接数。
DATABASE_POOL_SIZE=5
# 连接池耗尽后允许临时打开的额外数据库连接数。
DATABASE_MAX_OVERFLOW=10
# 等待可用数据库连接的最长时间（秒）。
DATABASE_POOL_TIMEOUT_SECONDS=30
# 连接在池中存活多久后主动回收（秒）；-1 表示不主动回收。
DATABASE_POOL_RECYCLE_SECONDS=-1
# 从连接池取出连接前是否做可用性探测，可降低空闲连接失效带来的报错。
DATABASE_POOL_PRE_PING=true

# --- Redis（缓存、租约与任务队列）----------------------------------

# Redis 连接地址；用于短期记忆缓存、租约、Celery broker 和结果存储。
REDIS_URL=redis://redis:6379/0
# 建立 Redis TCP 连接的超时时间（秒）。
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=3
# 单次 Redis 读写操作的超时时间（秒）。
REDIS_SOCKET_TIMEOUT_SECONDS=3

# --- Qdrant（向量数据库）--------------------------------------------

# Qdrant HTTP 服务地址；用于知识库向量检索和可选的记忆向量索引。
QDRANT_URL=http://qdrant:6333
# 知识库文档 chunk 向量集合名；嵌入模型或维度变化后应使用新集合并重建索引。
QDRANT_COLLECTION=knowledge_chunks
# 单次 Qdrant 客户端请求的超时时间（秒）。
QDRANT_TIMEOUT_SECONDS=10
# Qdrant、MinIO 和 Celery 健康检查超时时间；Redis 使用独立 socket 超时。
HEALTHCHECK_TIMEOUT_SECONDS=3
# 长期记忆向量索引集合名；仅在 MEMORY_VECTOR_INDEX_ENABLED=true 时参与加速召回。
MEMORY_QDRANT_COLLECTION=user_memories
# 是否启用长期记忆的 Qdrant 向量索引；PostgreSQL 仍是权威存储。
MEMORY_VECTOR_INDEX_ENABLED=false

# --- MinIO（对象存储）-----------------------------------------------

# MinIO 服务端点，格式为 host:port，不包含 http:// 或 https://。
MINIO_ENDPOINT=minio:9000
# MinIO 访问密钥；生产环境建议使用最低权限的应用专用凭据。
MINIO_ACCESS_KEY=minioadmin
# MinIO 访问密钥对应的 Secret；生产环境应由密钥管理系统注入并定期轮换。
MINIO_SECRET_KEY=minioadmin
# 保存原始上传文档的 MinIO Bucket 名称。
MINIO_BUCKET=documents
# 后端访问 MinIO 时是否启用 TLS；Compose 内网部署通常保持 false。
MINIO_SECURE=false

# --- LLM 提供者和任务温度 ------------------------------------------

# LLM 适配器名称；当前实现支持 openai_compatible。
LLM_PROVIDER=openai_compatible
# OpenAI 兼容 Chat Completions 服务地址；按供应商要求填写，通常以 /v1 结尾。
LLM_BASE_URL=https://api.openai.com/v1
# LLM 服务凭据；真实密钥只应放在未提交的 .env 或密钥管理系统中。
LLM_API_KEY=replace-me
# 聊天模型标识；需与所选 LLM 供应商的模型名称一致。
LLM_MODEL=gpt-4o-mini
# 单次 LLM 请求超时时间（秒）；应覆盖常见 RAG、摘要和记忆写入调用。
LLM_TIMEOUT_SECONDS=60
# 未指定任务温度时的回退温度；实用项目建议保持低温以稳定输出。
LLM_DEFAULT_TEMPERATURE=0.2
# 对话摘要温度；低温可减少摘要漂移和事实改写。
LLM_SUMMARY_TEMPERATURE=0.1
# 记忆提取、冲突检测和协调温度；0 可提高结构化操作稳定性。
LLM_MEMORY_EDITOR_TEMPERATURE=0.0
# Memory/RAG 上下文压缩温度；0 便于稳定复现和校验。
LLM_CONTEXT_COMPRESSION_TEMPERATURE=0.0

# --- 嵌入提供者 -----------------------------------------------------

# 嵌入模型适配器名称；当前实现支持 openai_compatible。
EMBEDDING_PROVIDER=openai_compatible
# OpenAI 兼容 Embeddings 服务地址；可与 LLM_BASE_URL 使用不同供应商。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 嵌入服务凭据；可与 LLM_API_KEY 不同。
EMBEDDING_API_KEY=replace-me
# 嵌入模型标识；模型或维度变化后必须重建知识库向量集合。
EMBEDDING_MODEL=text-embedding-v4
# 嵌入向量维度；必须与模型实际输出和 Qdrant 集合维度一致。
EMBEDDING_DIMENSION=1024
# 单次嵌入请求包含的最大文本条数；过大可能触发供应商限流。
EMBEDDING_BATCH_SIZE=10
# 单次嵌入请求超时时间（秒）。
EMBEDDING_TIMEOUT_SECONDS=30

# --- Agent 编排和流式响应 ------------------------------------------

# 单轮最多执行的模型调用次数；最后一次会移除工具并要求直接回答。
AGENT_MAX_MODEL_CALLS=6
# 单轮 memory 与 rag 工具调用总上限。
AGENT_MAX_TOOL_CALLS=4
# 单轮 memory 工具调用上限。
AGENT_MAX_MEMORY_CALLS=2
# 单轮 rag 工具调用上限。
AGENT_MAX_RAG_CALLS=3
# 回传给模型的单次工具观察最大字符数。
AGENT_TOOL_OBSERVATION_MAX_CHARS=2400
# 每个 Uvicorn 进程允许的并发流式 Agent 运行数。
AGENT_STREAM_MAX_CONCURRENCY=8
# 单次 Agent 运行从工作线程到 SSE 响应的事件缓冲队列大小。
AGENT_STREAM_QUEUE_MAXSIZE=128
# 单次流式 Agent 运行的最小截止时间（秒）。
AGENT_STREAM_MIN_TIMEOUT_SECONDS=30
# 按 LLM_TIMEOUT_SECONDS 推导 Agent 截止时间时使用的 LLM 调用次数预算。
AGENT_STREAM_TIMEOUT_LLM_CALLS=8
# 会话租约在 Agent 截止时间之外额外保留的宽限时间（秒）。
CONVERSATION_LEASE_GRACE_SECONDS=30
# 进程内延迟摘要调度队列容量；用于削峰并避免同步阻塞请求。
CONVERSATION_SUMMARY_DISPATCH_QUEUE_SIZE=256

# --- 混合检索、融合和上下文 ----------------------------------------

# 请求未指定 top_k 时最终注入答案生成的 chunk 数；实用知识库建议 6 作为召回与成本折中。
RETRIEVAL_TOP_K=6
# 每条检索路径进入融合前保留的候选数；增大可提升召回但会增加排序和日志成本。
RETRIEVAL_ROUTE_LIMIT=10
# Dense 检索预取规模相对 RETRIEVAL_ROUTE_LIMIT 的倍数。
RETRIEVAL_DENSE_PREFILTER_MULTIPLIER=4
# BM25 预过滤时最多使用的标准化查询词数量。
RETRIEVAL_BM25_PREFILTER_TERMS=12
# 检索诊断日志中保留的最大命中词数量。
RETRIEVAL_MAX_MATCHED_TERMS=32
# Reciprocal Rank Fusion 平滑常数；值越大，不同排名之间的分差越平缓。
RRF_K=60
# 单次用户问题最大 token 数；超限会明确拒绝，不会静默截断。
QUESTION_MAX_TOKENS=1000
# 注入答案生成的 RAG 证据独立 token 上限。
RAG_CONTEXT_MAX_TOKENS=6000
# 压缩模型的目标占组件硬上限比例，为格式化和 tokenizer 误差预留空间。
CONTEXT_COMPRESSION_TARGET_RATIO=0.9
# 压缩结果超限或校验失败时允许重试的次数。
CONTEXT_COMPRESSION_RETRY_LIMIT=1

# --- 短期记忆和长期记忆 --------------------------------------------

# Redis 短期记忆中保留的最近对话消息数。
SHORT_MEMORY_MAX_MESSAGES=16
# Redis 短期记忆缓存的生存时间（秒）。
SHORT_MEMORY_TTL_SECONDS=86400
# 单条最近消息写入短期记忆时保留的最大字符数。
SHORT_MEMORY_CONTENT_MAX_CHARS=2000
# 注入提示词的完整记忆上下文硬字符上限；避免长期记忆挤占知识证据。
MEMORY_CONTEXT_MAX_CHARS=6000
# 记忆上下文主 token 预算；实用项目建议控制在 1k-2k token 区间。
MEMORY_CONTEXT_MAX_TOKENS=1600
# 格式化记忆上下文时最多考虑的长期记忆条数。
MEMORY_CONTEXT_MAX_LONG_MEMORIES=10
# 画像、偏好和固定记忆在记忆上下文预算中的相对权重。
MEMORY_CONTEXT_PROFILE_WEIGHT=0.30
# 普通长期记忆在记忆上下文预算中的相对权重。
MEMORY_CONTEXT_LONG_TERM_WEIGHT=0.30
# 对话摘要在记忆上下文预算中的相对权重。
MEMORY_CONTEXT_SUMMARY_WEIGHT=0.25
# 最近消息在记忆上下文预算中的相对权重。
MEMORY_CONTEXT_RECENT_WEIGHT=0.15
# 某个记忆区段为空时保留的预算比例，用于降低空段浪费。
MEMORY_CONTEXT_EMPTY_SECTION_WEIGHT_FACTOR=0.20
# 启用 token 预算时，每个非空记忆区段的最小 token 配额。
MEMORY_CONTEXT_MIN_SECTION_TOKENS=32
# 未启用 token 预算时，每个非空记忆区段的最小字符配额。
MEMORY_CONTEXT_MIN_SECTION_CHARS=80
# 自动长期记忆写入模式：sync、async 或 disabled；async 需要 Worker 和 Beat 正常运行。
MEMORY_UPDATE_MODE=sync
# 语义去重和冲突判断的相似度阈值；越高越保守。
MEMORY_SEMANTIC_THRESHOLD=0.84
# 由 MEMORY_SEMANTIC_THRESHOLD 推导记忆召回阈值的乘数。
MEMORY_RECALL_THRESHOLD_FACTOR=0.40
# 派生记忆召回阈值的下限。
MEMORY_RECALL_THRESHOLD_MIN=0.25
# 派生记忆召回阈值的上限。
MEMORY_RECALL_THRESHOLD_MAX=0.50
# 判定记忆来源文本可被原文支撑所需的最小词汇重叠比例。
MEMORY_GROUNDING_OVERLAP_THRESHOLD=0.30
# 单次记忆审查最多允许的创建、更新、合并或替换操作数。
MEMORY_MAX_OPERATIONS=3
# 记忆编辑器提示词中带入的现有记忆上限。
MEMORY_EDITOR_CONTEXT_LIMIT=30
# 构建记忆编辑候选集时扫描的活跃记忆上限。
MEMORY_EDITOR_CANDIDATE_LIMIT=80
# 语义召回回退路径扫描的最近记忆候选上限。
MEMORY_RECALL_CANDIDATE_LIMIT=120
# 随记忆候选保存的来源文本最大字符数。
MEMORY_SOURCE_MAX_CHARS=700
# 传入记忆审查的新摘要增量最大字符数。
MEMORY_SUMMARY_DELTA_MAX_CHARS=12000
# 显式请求查看全部记忆时返回的最大记录数。
MEMORY_FULL_RECALL_LIMIT=20
# 每轮加载的画像、偏好和固定记忆上限。
MEMORY_PROFILE_LIMIT=12
# 普通语义召回最终选入上下文的记忆条数上限。
MEMORY_SEMANTIC_LIMIT=6
# 记忆审查和治理流程中加载的待处理记忆上限。
MEMORY_PENDING_LIMIT=10
# 单次记忆协调任务最多检查的语义候选对数量。
MEMORY_RECONCILE_MAX_SEMANTIC_PAIRS=2000

# --- 增量对话摘要 ---------------------------------------------------

# 未摘要内容达到该估算 token 数后触发摘要更新。
CONVERSATION_SUMMARY_TRIGGER_TOKENS=2000
# 执行常规摘要前要求的最小未处理 token 数。
CONVERSATION_SUMMARY_MIN_TOKENS=500
# 执行常规摘要前要求的最小未处理消息数。
CONVERSATION_SUMMARY_MIN_MESSAGES=8
# 单次摘要任务最多处理的未摘要消息数。
CONVERSATION_SUMMARY_MAX_UNPROCESSED=30
# 会话摘要独立 token 上限；提示词会明确要求模型遵守该目标。
CONVERSATION_SUMMARY_MAX_TOKENS=1200
# 摘要任务的最小租约时间；实际值会覆盖最坏 LLM 调用预算。
CONVERSATION_SUMMARY_LEASE_MIN_SECONDS=60

# --- Celery 可靠性和恢复 -------------------------------------------

# 普通 Celery 任务最大重试次数；持久记忆作业有独立租约语义。
CELERY_TASK_MAX_RETRIES=3
# Celery 指数退避的初始重试延迟（秒）。
CELERY_TASK_RETRY_BACKOFF_SECONDS=5
# Celery 指数退避允许的最大重试延迟（秒）。
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=300
# Celery 结果后端保存任务结果的时间（秒）。
CELERY_RESULT_EXPIRES_SECONDS=86400
# Redis broker 可见性超时下限（秒），用于避免长任务过早重新投递。
CELERY_BROKER_VISIBILITY_TIMEOUT_MIN_SECONDS=3600
# 按长任务租约推导 broker 可见性超时时使用的乘数。
CELERY_BROKER_VISIBILITY_TIMEOUT_LEASE_MULTIPLIER=3
# 每个 Celery worker 进程预取的任务数；长任务场景建议保持 1。
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# 每日运营保留任务消息的过期时间（秒）。
CELERY_OPERATIONAL_RETENTION_TASK_EXPIRES_SECONDS=82800
# 单轮恢复流程最多声明或修复的持久作业数。
WORKER_RECOVERY_BATCH_SIZE=100
# 恢复流程扫描候选作业时相对批量大小的倍数。
WORKER_RECOVERY_SCAN_MULTIPLIER=5
# 记忆写入和清理持久作业的处理租约（秒）；需覆盖最坏 LLM 调用预算。
MEMORY_UPDATE_JOB_LEASE_SECONDS=600
# 记忆、清理、摘要和延迟作业恢复扫描周期（秒）。
MEMORY_UPDATE_JOB_RECOVERY_INTERVAL_SECONDS=60
# 每日运营日志保留任务运行的 UTC 小时（0-23）。
OPERATIONAL_RETENTION_HOUR_UTC=2

# --- 运营日志保留 ---------------------------------------------------

# LLM 调用日志保留天数；0 表示禁用该类自动删除。
LLM_CALL_LOG_RETENTION_DAYS=90
# 检索日志保留天数；0 表示禁用该类自动删除。
RETRIEVAL_LOG_RETENTION_DAYS=90
# 已完成 AgentRun 记录保留天数；0 表示禁用该类自动删除。
AGENT_RUN_RETENTION_DAYS=90
# 记忆召回日志保留天数；0 表示禁用该类自动删除。
MEMORY_RECALL_LOG_RETENTION_DAYS=90
# 终态记忆更新作业保留天数；0 表示禁用自动删除。
MEMORY_UPDATE_JOB_RETENTION_DAYS=30
# 终态外部清理作业保留天数；0 表示禁用自动删除。
EXTERNAL_CLEANUP_JOB_RETENTION_DAYS=30

# --- 文档摄取 -------------------------------------------------------

# 默认文档切块字符数；面向中文制度、方案和知识库文档建议约 900 字符。
DEFAULT_CHUNK_SIZE=900
# 相邻文档 chunk 的重叠字符数；需小于 DEFAULT_CHUNK_SIZE。
DEFAULT_CHUNK_OVERLAP=150
# 后端允许上传的单文件最大体积（MiB）。
MAX_UPLOAD_SIZE_MB=50

# --- 认证 -----------------------------------------------------------

# Bcrypt 密码哈希工作因子；值越高，登录 CPU 成本越高。
BCRYPT_ROUNDS=12
# JWT 签名密钥；生产环境至少 32 个随机字节，并应支持轮换。
JWT_SECRET_KEY=dev-only-change-me-dev-secret-32-bytes
# JWT 签名算法；当前后端仅允许 HS256。
JWT_ALGORITHM=HS256
# 访问令牌有效期（分钟）。
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# 刷新令牌有效期（天）。
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
