# Application
APP_ENV=production
APP_NAME=agentic-rag-platform
API_PREFIX=/api
BACKEND_CORS_ORIGINS=https://your-rag.example.com
# The production Nginx container proxies /api to the backend.
VITE_API_BASE_URL=/api
TRANSFORMERS_VERBOSITY=error

# PostgreSQL and SQLAlchemy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_app
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg://rag_user:replace-with-a-strong-postgres-password@postgres:5432/rag_app
AUTO_CREATE_TABLES=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_chunks
QDRANT_TIMEOUT_SECONDS=10
HEALTHCHECK_TIMEOUT_SECONDS=3
MEMORY_QDRANT_COLLECTION=user_memories
MEMORY_VECTOR_INDEX_ENABLED=true

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-a-strong-minio-access-key
MINIO_SECRET_KEY=replace-with-a-strong-minio-secret-key
MINIO_BUCKET=documents
MINIO_SECURE=false

# LLM provider and task temperatures
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_DEFAULT_TEMPERATURE=0.1
LLM_INTENT_TEMPERATURE=0.0
LLM_SUMMARY_TEMPERATURE=0.2
LLM_WRITING_TEMPERATURE=0.3
LLM_CHAT_TEMPERATURE=0.2
LLM_RAG_TEMPERATURE=0.2
LLM_MEMORY_ANSWER_TEMPERATURE=0.2
LLM_MEMORY_EDITOR_TEMPERATURE=0.0
LLM_QUERY_REWRITE_TEMPERATURE=0.0

# Embedding provider. Dimension must match the configured model and existing collections.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30

# Agent orchestration and streaming. Concurrency is per Uvicorn process.
AGENT_GRAPH_BACKEND=langgraph
AGENT_STREAM_MAX_CONCURRENCY=8
AGENT_STREAM_QUEUE_MAXSIZE=128
AGENT_STREAM_MIN_TIMEOUT_SECONDS=30
AGENT_STREAM_TIMEOUT_LLM_CALLS=4
CONVERSATION_LEASE_GRACE_SECONDS=30
CONVERSATION_SUMMARY_DISPATCH_QUEUE_SIZE=256

# Query planning, retrieval, fusion, and context compression
RETRIEVAL_TOP_K=5
RETRIEVAL_ROUTE_LIMIT=8
RETRIEVAL_MAX_ROUTE_QUERIES=4
RETRIEVAL_ORIGINAL_QUERY_WEIGHT=1.2
RETRIEVAL_REWRITE_QUERY_WEIGHT=1.1
RETRIEVAL_SUBQUERY_WEIGHT=1.0
RETRIEVAL_DENSE_PREFILTER_MULTIPLIER=4
RETRIEVAL_BM25_PREFILTER_TERMS=12
RETRIEVAL_MAX_MATCHED_TERMS=32
RRF_K=60
QUERY_REWRITE_MAX_CHARS=300
QUERY_REWRITE_SUBQUERY_MAX_CHARS=300
QUERY_REWRITE_MAX_SUBQUERIES=3
CONTEXT_COMPRESSION_CHUNK_CHARS=700
CONTEXT_COMPRESSION_FALLBACK_SENTENCES=2
ANSWER_CONTEXT_MAX_CHARS=4000

# Short-term and long-term memory
SHORT_MEMORY_MAX_MESSAGES=12
SHORT_MEMORY_TTL_SECONDS=86400
SHORT_MEMORY_CONTENT_MAX_CHARS=2000
MEMORY_CONTEXT_MAX_CHARS=3000
MEMORY_CONTEXT_MAX_TOKENS=900
MEMORY_CONTEXT_MAX_LONG_MEMORIES=8
MEMORY_CONTEXT_PROFILE_WEIGHT=0.25
MEMORY_CONTEXT_LONG_TERM_WEIGHT=0.35
MEMORY_CONTEXT_SUMMARY_WEIGHT=0.20
MEMORY_CONTEXT_RECENT_WEIGHT=0.20
MEMORY_CONTEXT_EMPTY_SECTION_WEIGHT_FACTOR=0.20
MEMORY_CONTEXT_MIN_SECTION_TOKENS=24
MEMORY_CONTEXT_MIN_SECTION_CHARS=80
MEMORY_UPDATE_MODE=async
MEMORY_SEMANTIC_THRESHOLD=0.82
MEMORY_RECALL_THRESHOLD_FACTOR=0.35
MEMORY_RECALL_THRESHOLD_MIN=0.20
MEMORY_RECALL_THRESHOLD_MAX=0.45
MEMORY_GROUNDING_OVERLAP_THRESHOLD=0.3333333333333333
MEMORY_MAX_OPERATIONS=3
MEMORY_EDITOR_CONTEXT_LIMIT=30
MEMORY_EDITOR_CANDIDATE_LIMIT=80
MEMORY_RECALL_CANDIDATE_LIMIT=120
MEMORY_SOURCE_MAX_CHARS=700
MEMORY_SUMMARY_DELTA_MAX_CHARS=12000
MEMORY_FULL_RECALL_LIMIT=20
MEMORY_PROFILE_LIMIT=20
MEMORY_SEMANTIC_LIMIT=5
MEMORY_PENDING_LIMIT=10
MEMORY_RECONCILE_MAX_SEMANTIC_PAIRS=2000

# Incremental conversation summary
CONVERSATION_SUMMARY_TRIGGER_TOKENS=2000
CONVERSATION_SUMMARY_MIN_TOKENS=500
CONVERSATION_SUMMARY_MIN_MESSAGES=8
CONVERSATION_SUMMARY_MAX_UNPROCESSED=30
CONVERSATION_SUMMARY_MAX_CHARS=3000
CONVERSATION_SUMMARY_LEASE_MIN_SECONDS=60

# Celery reliability and recovery. Memory lease must cover
# (1 + MEMORY_MAX_OPERATIONS) * LLM_TIMEOUT_SECONDS.
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=5
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=300
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_BROKER_VISIBILITY_TIMEOUT_MIN_SECONDS=3600
CELERY_BROKER_VISIBILITY_TIMEOUT_LEASE_MULTIPLIER=3
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_OPERATIONAL_RETENTION_TASK_EXPIRES_SECONDS=82800
WORKER_RECOVERY_BATCH_SIZE=100
WORKER_RECOVERY_SCAN_MULTIPLIER=5
MEMORY_UPDATE_JOB_LEASE_SECONDS=600
MEMORY_UPDATE_JOB_RECOVERY_INTERVAL_SECONDS=60
OPERATIONAL_RETENTION_HOUR_UTC=2

# Operational retention. Set an individual value to 0 to disable that target.
LLM_CALL_LOG_RETENTION_DAYS=90
RETRIEVAL_LOG_RETENTION_DAYS=90
AGENT_RUN_RETENTION_DAYS=90
MEMORY_RECALL_LOG_RETENTION_DAYS=90
MEMORY_UPDATE_JOB_RETENTION_DAYS=30
EXTERNAL_CLEANUP_JOB_RETENTION_DAYS=30

# Document ingestion
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
MAX_UPLOAD_SIZE_MB=50

# Authentication
BCRYPT_ROUNDS=12
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
