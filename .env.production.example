# Production template for the bundled Docker Compose deployment reference.
# Copy this file to .env and replace every credential, origin, and placeholder.
# Every supported setting is documented immediately above its assignment.

# --- Application -----------------------------------------------------------

# Service env-file path relative to infra/*.yml; keep it aligned with any nonstandard --env-file.
APP_ENV_FILE=../.env
# Runtime profile. "production" and "prod" enable strict security validation.
APP_ENV=production
# Service name exposed in FastAPI metadata and health responses.
APP_NAME=knowledge-work-assistant
# Backend route prefix. Keep the frontend base URL and Nginx proxy in sync if changed.
API_PREFIX=/api
# Comma-separated browser origins; production requires real HTTPS origins and rejects wildcards.
BACKEND_CORS_ORIGINS=https://your-rag.example.com
# Frontend API base URL; Vite reads this at development or image build time.
VITE_API_BASE_URL=/api
# Nginx request-body limit in MiB; it must exceed MAX_UPLOAD_SIZE_MB for multipart overhead.
NGINX_MAX_BODY_SIZE_MB=52
# Nginx upstream read/send timeout; it must cover the computed Agent stream deadline.
NGINX_PROXY_TIMEOUT_SECONDS=300
# Logging level passed to Hugging Face Transformers dependencies.
TRANSFORMERS_VERBOSITY=error

# --- PostgreSQL and SQLAlchemy --------------------------------------------

# Database created by the PostgreSQL container when its data volume is empty.
POSTGRES_DB=rag_app
# Database user created by the PostgreSQL container on first initialization.
POSTGRES_USER=rag_user
# Production database credential; inject and rotate it, noting existing volumes are not reinitialized.
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
# Authoritative SQLAlchemy URL for API/workers/migrations; URL-encode reserved password characters.
DATABASE_URL=postgresql+psycopg://rag_user:replace-with-a-strong-postgres-password@postgres:5432/rag_app
# Development convenience only; production must use false and run Alembic migrations.
AUTO_CREATE_TABLES=false
# Number of persistent connections kept in each SQLAlchemy process pool.
DATABASE_POOL_SIZE=10
# Additional temporary connections allowed above DATABASE_POOL_SIZE.
DATABASE_MAX_OVERFLOW=20
# Maximum seconds to wait for a pooled database connection.
DATABASE_POOL_TIMEOUT_SECONDS=30
# Seconds before recycling a pooled connection; -1 disables recycling.
DATABASE_POOL_RECYCLE_SECONDS=1800
# Check connection liveness before checkout from the pool.
DATABASE_POOL_PRE_PING=true

# --- Redis -----------------------------------------------------------------

# Redis connection used for short-term memory, leases, Celery broker, and results.
REDIS_URL=redis://redis:6379/0
# Maximum seconds allowed to establish a Redis connection.
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=3
# Maximum seconds allowed for an individual Redis operation.
REDIS_SOCKET_TIMEOUT_SECONDS=3

# --- Qdrant ----------------------------------------------------------------

# Qdrant HTTP endpoint used by document and optional memory vector indexes.
QDRANT_URL=http://qdrant:6333
# Collection that stores knowledge-base chunk embeddings.
QDRANT_COLLECTION=knowledge_chunks
# Maximum seconds for Qdrant client operations.
QDRANT_TIMEOUT_SECONDS=10
# Timeout for Qdrant, MinIO, and Celery readiness probes; Redis uses its own socket timeouts.
HEALTHCHECK_TIMEOUT_SECONDS=3
# Collection used by the optional long-term memory vector index.
MEMORY_QDRANT_COLLECTION=user_memories
# Enable best-effort Qdrant acceleration for memory recall; PostgreSQL remains authoritative.
MEMORY_VECTOR_INDEX_ENABLED=true

# --- MinIO -----------------------------------------------------------------

# MinIO endpoint in host:port form, without an http:// or https:// scheme.
MINIO_ENDPOINT=minio:9000
# Bundled MinIO root access key; provision separate least-privilege application credentials when possible.
MINIO_ACCESS_KEY=replace-with-a-strong-minio-access-key
# Bundled MinIO root secret; inject it from a secret manager and rotate it operationally.
MINIO_SECRET_KEY=replace-with-a-strong-minio-secret-key
# Bucket used to store original uploaded documents.
MINIO_BUCKET=documents
# Use TLS for backend-to-MinIO traffic; false assumes the private Compose network.
MINIO_SECURE=false

# --- LLM provider and task temperatures -----------------------------------

# LLM adapter name; the current implementation supports openai_compatible.
LLM_PROVIDER=openai_compatible
# OpenAI-compatible chat-completions base URL, normally ending in /v1.
LLM_BASE_URL=https://api.openai.com/v1
# LLM provider credential. Use a real key only in the ignored .env file.
LLM_API_KEY=replace-with-your-llm-api-key
# Chat model identifier understood by the configured provider.
LLM_MODEL=gpt-4o-mini
# Maximum seconds for one LLM request.
LLM_TIMEOUT_SECONDS=30
# Fallback temperature when a call site does not provide a task-specific value (0-2).
LLM_DEFAULT_TEMPERATURE=0.1
# Intent-classification temperature; lower values improve routing determinism (0-2).
LLM_INTENT_TEMPERATURE=0.0
# Conversation-summary generation temperature (0-2).
LLM_SUMMARY_TEMPERATURE=0.2
# Evidence-grounded writing temperature (0-2).
LLM_WRITING_TEMPERATURE=0.3
# General conversational response temperature (0-2).
LLM_CHAT_TEMPERATURE=0.2
# Retrieval-grounded answer temperature (0-2).
LLM_RAG_TEMPERATURE=0.2
# User-memory answer temperature (0-2).
LLM_MEMORY_ANSWER_TEMPERATURE=0.2
# Memory extraction, conflict review, and reconciliation temperature (0-2).
LLM_MEMORY_EDITOR_TEMPERATURE=0.0
# Query rewrite and decomposition temperature (0-2).
LLM_QUERY_REWRITE_TEMPERATURE=0.0

# --- Embedding provider ----------------------------------------------------

# Embedding adapter name; the current implementation supports openai_compatible.
EMBEDDING_PROVIDER=openai_compatible
# OpenAI-compatible embeddings base URL, which may differ from LLM_BASE_URL.
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Embedding provider credential. It may differ from LLM_API_KEY.
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
# Embedding model identifier understood by the configured provider.
EMBEDDING_MODEL=text-embedding-3-small
# Output dimension; model changes require rebuilding knowledge and enabled memory collections.
EMBEDDING_DIMENSION=1536
# Maximum number of texts sent in one embedding request.
EMBEDDING_BATCH_SIZE=10
# Maximum seconds for one embedding request.
EMBEDDING_TIMEOUT_SECONDS=30

# --- Agent orchestration and streaming ------------------------------------

# Execution backend: langgraph or sequential.
AGENT_GRAPH_BACKEND=langgraph
# Maximum simultaneous streaming agent runs per Uvicorn process (1-256).
AGENT_STREAM_MAX_CONCURRENCY=8
# Maximum events buffered between an agent worker thread and one SSE response.
AGENT_STREAM_QUEUE_MAXSIZE=128
# Minimum wall-clock deadline for one streaming agent run, in seconds.
AGENT_STREAM_MIN_TIMEOUT_SECONDS=30
# LLM timeout multiplier used to derive the agent run deadline.
AGENT_STREAM_TIMEOUT_LLM_CALLS=4
# Extra seconds added to the conversation lease beyond the computed run deadline.
CONVERSATION_LEASE_GRACE_SECONDS=30
# In-process queue capacity for deferred conversation-summary dispatches.
CONVERSATION_SUMMARY_DISPATCH_QUEUE_SIZE=256

# --- Query planning, retrieval, fusion, and context -----------------------

# Final number of chunks selected for an answer when the request omits top_k.
RETRIEVAL_TOP_K=5
# Maximum candidates retained from each retrieval route before fusion.
RETRIEVAL_ROUTE_LIMIT=8
# Maximum original, rewritten, and subquery routes evaluated per request.
RETRIEVAL_MAX_ROUTE_QUERIES=4
# Weighted-RRF contribution multiplier for the original query route.
RETRIEVAL_ORIGINAL_QUERY_WEIGHT=1.2
# Weighted-RRF contribution multiplier for the rewritten query route.
RETRIEVAL_REWRITE_QUERY_WEIGHT=1.1
# Weighted-RRF contribution multiplier for each generated subquery route.
RETRIEVAL_SUBQUERY_WEIGHT=1.0
# Dense prefetch size multiplier relative to the route limit.
RETRIEVAL_DENSE_PREFILTER_MULTIPLIER=4
# Maximum normalized query terms considered by the BM25 prefilter.
RETRIEVAL_BM25_PREFILTER_TERMS=12
# Maximum matched terms retained in candidate retrieval diagnostics.
RETRIEVAL_MAX_MATCHED_TERMS=32
# Reciprocal-rank-fusion smoothing constant; larger values flatten rank differences.
RRF_K=60
# Maximum characters accepted from the LLM rewritten query.
QUERY_REWRITE_MAX_CHARS=300
# Maximum characters accepted for each generated subquery.
QUERY_REWRITE_SUBQUERY_MAX_CHARS=300
# Maximum number of generated subqueries; 0 disables subquery expansion.
QUERY_REWRITE_MAX_SUBQUERIES=3
# Target character size of each segment passed through context compression.
CONTEXT_COMPRESSION_CHUNK_CHARS=700
# Number of leading sentences kept when compression cannot produce a result.
CONTEXT_COMPRESSION_FALLBACK_SENTENCES=2
# Maximum compressed knowledge context characters supplied to answer generation.
ANSWER_CONTEXT_MAX_CHARS=4000

# --- Short-term and long-term memory --------------------------------------

# Maximum recent conversation messages retained in the Redis working-memory cache.
SHORT_MEMORY_MAX_MESSAGES=12
# Redis working-memory time to live, in seconds.
SHORT_MEMORY_TTL_SECONDS=86400
# Maximum characters cached from each recent message.
SHORT_MEMORY_CONTENT_MAX_CHARS=2000
# Hard character cap for the complete memory context injected into a prompt.
MEMORY_CONTEXT_MAX_CHARS=3000
# Primary token budget for the complete memory context.
MEMORY_CONTEXT_MAX_TOKENS=900
# Maximum long-term memory records considered during context formatting.
MEMORY_CONTEXT_MAX_LONG_MEMORIES=8
# Relative token-budget weight for pinned profile and preference memories.
MEMORY_CONTEXT_PROFILE_WEIGHT=0.25
# Relative token-budget weight for other selected long-term memories.
MEMORY_CONTEXT_LONG_TERM_WEIGHT=0.35
# Relative token-budget weight for the incremental conversation summary.
MEMORY_CONTEXT_SUMMARY_WEIGHT=0.20
# Relative token-budget weight for recent conversation messages.
MEMORY_CONTEXT_RECENT_WEIGHT=0.20
# Fraction of its normal weight retained by an empty context section (0-1).
MEMORY_CONTEXT_EMPTY_SECTION_WEIGHT_FACTOR=0.20
# Minimum allocation per non-empty section when token budgeting is active.
MEMORY_CONTEXT_MIN_SECTION_TOKENS=24
# Character-mode minimum allocation; used only when token budgeting is disabled explicitly.
MEMORY_CONTEXT_MIN_SECTION_CHARS=80
# Automatic long-term write mode: sync, async, or disabled; async requires worker and Beat.
MEMORY_UPDATE_MODE=async
# Similarity threshold used for semantic duplicate and conflict decisions (0-1).
MEMORY_SEMANTIC_THRESHOLD=0.82
# Multiplier applied to MEMORY_SEMANTIC_THRESHOLD to derive recall acceptance.
MEMORY_RECALL_THRESHOLD_FACTOR=0.35
# Lower clamp for the derived memory recall threshold (0-1).
MEMORY_RECALL_THRESHOLD_MIN=0.20
# Upper clamp for the derived memory recall threshold (0-1).
MEMORY_RECALL_THRESHOLD_MAX=0.45
# Minimum lexical overlap required to treat source text as grounded (0-1).
MEMORY_GROUNDING_OVERLAP_THRESHOLD=0.3333333333333333
# Maximum create, update, merge, or supersede operations from one memory review.
MEMORY_MAX_OPERATIONS=3
# Maximum existing memories included in the memory editor prompt.
MEMORY_EDITOR_CONTEXT_LIMIT=30
# Maximum active memories scanned when constructing editor candidates.
MEMORY_EDITOR_CANDIDATE_LIMIT=80
# Maximum recent memories scanned by bounded semantic recall fallback.
MEMORY_RECALL_CANDIDATE_LIMIT=120
# Maximum source-text characters stored with a memory candidate.
MEMORY_SOURCE_MAX_CHARS=700
# Maximum new conversation-summary characters passed to memory review.
MEMORY_SUMMARY_DELTA_MAX_CHARS=12000
# Maximum records returned by an explicit full-memory recall request.
MEMORY_FULL_RECALL_LIMIT=20
# Maximum sticky profile or preference memories loaded for a turn.
MEMORY_PROFILE_LIMIT=20
# Maximum semantic memories selected for normal recall.
MEMORY_SEMANTIC_LIMIT=5
# Maximum pending memories exposed to review and governance flows.
MEMORY_PENDING_LIMIT=10
# Maximum semantic pairs checked during one memory reconcile operation.
MEMORY_RECONCILE_MAX_SEMANTIC_PAIRS=2000

# --- Incremental conversation summary -------------------------------------

# Estimated unprocessed token count that triggers a summary update.
CONVERSATION_SUMMARY_TRIGGER_TOKENS=2000
# Minimum unprocessed token count required before a normal summary update.
CONVERSATION_SUMMARY_MIN_TOKENS=500
# Minimum unprocessed message count required before a normal summary update.
CONVERSATION_SUMMARY_MIN_MESSAGES=8
# Maximum unprocessed messages summarized in one worker execution.
CONVERSATION_SUMMARY_MAX_UNPROCESSED=30
# Maximum characters stored in the durable conversation summary.
CONVERSATION_SUMMARY_MAX_CHARS=3000
# Minimum summary-job lease duration; computed LLM budget may increase it.
CONVERSATION_SUMMARY_LEASE_MIN_SECONDS=60

# --- Celery reliability and recovery -------------------------------------

# Maximum retries for ordinary Celery tasks; memory jobs use durable job semantics.
CELERY_TASK_MAX_RETRIES=3
# Initial retry delay in seconds before exponential backoff.
CELERY_TASK_RETRY_BACKOFF_SECONDS=5
# Maximum retry delay in seconds after exponential backoff.
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=300
# Celery result-backend retention in seconds.
CELERY_RESULT_EXPIRES_SECONDS=86400
# Minimum Redis broker visibility timeout in seconds.
CELERY_BROKER_VISIBILITY_TIMEOUT_MIN_SECONDS=3600
# Lease multiplier used when deriving visibility timeout for long memory jobs.
CELERY_BROKER_VISIBILITY_TIMEOUT_LEASE_MULTIPLIER=3
# Tasks reserved per worker process; 1 reduces unfair prefetch for long jobs.
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Expiry in seconds for the daily retention task message.
CELERY_OPERATIONAL_RETENTION_TASK_EXPIRES_SECONDS=82800
# Maximum durable jobs claimed or repaired in one recovery batch.
WORKER_RECOVERY_BATCH_SIZE=100
# Candidate scan multiplier used to find enough eligible recovery jobs.
WORKER_RECOVERY_SCAN_MULTIPLIER=5
# Lease for durable memory and cleanup jobs; cover (1 + max operations) LLM timeouts.
MEMORY_UPDATE_JOB_LEASE_SECONDS=600
# Beat interval in seconds for memory, cleanup, summary, and deferred-job recovery.
MEMORY_UPDATE_JOB_RECOVERY_INTERVAL_SECONDS=60
# UTC hour (0-23) at which operational retention runs daily.
OPERATIONAL_RETENTION_HOUR_UTC=2

# --- Operational retention ------------------------------------------------

# Days to retain LLM call logs; 0 disables automatic deletion for this target.
LLM_CALL_LOG_RETENTION_DAYS=90
# Days to retain retrieval logs; 0 disables automatic deletion for this target.
RETRIEVAL_LOG_RETENTION_DAYS=90
# Days to retain completed agent runs; 0 disables automatic deletion for this target.
AGENT_RUN_RETENTION_DAYS=90
# Days to retain memory recall logs; 0 disables automatic deletion for this target.
MEMORY_RECALL_LOG_RETENTION_DAYS=90
# Days to retain terminal memory update jobs; 0 disables automatic deletion.
MEMORY_UPDATE_JOB_RETENTION_DAYS=30
# Days to retain terminal external cleanup jobs; 0 disables automatic deletion.
EXTERNAL_CLEANUP_JOB_RETENTION_DAYS=30

# --- Document ingestion ---------------------------------------------------

# Default document chunk size in characters.
DEFAULT_CHUNK_SIZE=800
# Character overlap between adjacent chunks; it must be smaller than chunk size.
DEFAULT_CHUNK_OVERLAP=120
# Maximum uploaded file size in MiB enforced by the backend.
MAX_UPLOAD_SIZE_MB=50

# --- Authentication --------------------------------------------------------

# Bcrypt work factor for password hashes (4-31); higher values cost more CPU.
BCRYPT_ROUNDS=12
# Production JWT signing secret; inject at least 32 random bytes and establish rotation.
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
# JWT signing algorithm used for access and refresh tokens.
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh-token lifetime in days.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
